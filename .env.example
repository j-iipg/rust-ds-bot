# ===== Discord =====
DISCORD_TOKEN=токен_бота_из_developer_portal
# ID канала, куда бот пишет смерти/ивенты и откуда берёт сообщения для моста
DISCORD_CHANNEL_ID=123456789012345678

# ===== Rust+ (берётся из npx rustplus fcm-listen после "Pair with server") =====
RUST_IP=1.2.3.4
RUST_PORT=28082
RUST_PLAYER_ID=76561198000000000
RUST_PLAYER_TOKEN=-123456789

# ===== Настройки =====
# Писать ли смерти/онлайн/ивенты ещё и в тим-чат игры (true/false)
POST_TO_TEAMCHAT=true
# Как часто опрашивать сервер, в секундах
TEAM_POLL_SECONDS=5
EVENTS_POLL_SECONDS=10
