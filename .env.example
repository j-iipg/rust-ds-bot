# ===== Discord =====
DISCORD_TOKEN=токен_бота_из_developer_portal
# ID канала, куда бот пишет смерти/ивенты и откуда берёт сообщения для моста
DISCORD_CHANNEL_ID=123456789012345678

# ===== Rust+ (берётся из npm run pair после "Pair with server") =====
# С ноября 2026 Rust+ работает через relay Facepunch: нужен "id" сервера из уведомления.
# Rust+ токен берётся сам из rustplus.config.json (npm run register, обновлять раз в ~2 недели)
RUST_SERVER_ID=545e3a09-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Старый способ (прямое подключение) — только если RUST_SERVER_ID пустой:
RUST_IP=
RUST_PORT=
RUST_PLAYER_ID=76561198000000000
RUST_PLAYER_TOKEN=-123456789

# ===== Безопасность =====
# Роль, у которой есть доступ к боту (название или ID роли). Пусто — доступ у всех, кто видит канал
ACCESS_ROLE=Пачка
# DATA_KEY — ключ шифрования токенов. Бот создаст его сам при первом запуске. Не меняй и не удаляй!

# ===== Настройки =====
# Писать ли смерти/онлайн/ивенты ещё и в тим-чат игры (true/false)
POST_TO_TEAMCHAT=true
# Как часто опрашивать сервер, в секундах
TEAM_POLL_SECONDS=5
EVENTS_POLL_SECONDS=10
